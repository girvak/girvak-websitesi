# Build-time: where Astro fetches content from (FastAPI backend)
# Dev:  http://localhost:8000
# Prod build on VPS (backend docker :8082): http://127.0.0.1:8082
API_BASE_URL=http://localhost:8000

# Public site URL — used for canonical links + sitemap
# Dev:  http://localhost:4321
# Prod: https://girisimcilikvakfi.org
PUBLIC_SITE_URL=http://localhost:4321

# Client-side: backend base used by the newsletter form.
# Dev:  http://localhost:8000
# Prod: leave empty — nginx on :80 proxies /api to backend :8082 (same-origin)
PUBLIC_API_BASE_URL=http://localhost:8000
