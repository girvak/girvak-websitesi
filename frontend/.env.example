# GİRVAK frontend configuration — names only; values live in the environment.

# Where the server-rendered pages read content from. Server-side only: this
# value never reaches the browser.
API_BASE_URL=http://127.0.0.1:8000

# What the browser posts the newsletter form to. Empty = same origin, which is
# what production uses (nginx forwards /api to FastAPI).
PUBLIC_API_BASE_URL=

# Canonical origin for canonical links, Open Graph and the sitemap.
PUBLIC_SITE_URL=https://girisimcilikvakfi.org

# How long a rendered page is reused before the API is asked again (seconds).
PAGE_CACHE_SECONDS=30
# What the browser may cache the HTML for (seconds).
BROWSER_CACHE_SECONDS=30
