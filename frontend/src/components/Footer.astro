---
import type { Footer } from '../lib/types';
interface Props { footer: Footer; apiBase: string; }
const { footer, apiBase } = Astro.props;
const c = footer.contact;

// One place decides where the form posts. Empty apiBase means same origin, and
// the reverse proxy forwards /api to FastAPI — so no API hostname is in the page.
const newsletterEndpoint = apiBase ? `${apiBase}/v1/newsletter` : '/api/v1/newsletter';
---
<footer class="ft" id="footer">
  <div class="ft-news">
    <div>
      <h3 style="color: #373d42; font-weight: 500">{footer.newsletter_title}</h3>
      <p>{footer.newsletter_text}</p>
    </div>
    <form class="ft-form" method="post" action={newsletterEndpoint} data-endpoint={newsletterEndpoint}>
      <input type="email" name="email" placeholder="type your email" aria-label="Email address" required style="border-radius: 5px" />
      <button type="submit" class="ft-subscribe"><span class="ft-sub-label">subscribe</span><span class="cta-arrow" aria-hidden="true"></span></button>
      <p class="ft-form-msg" role="status" aria-live="polite"></p>
    </form>
  </div>
  <div class="ft-main">
    <div class="ft-brand">
      <img src="/assets/logo-primary-turquoise.png" alt="GİRVAK" />
      <p>{footer.brand_text}</p>
      <div class="ft-social">
        <a href="#" aria-label="LinkedIn"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5A2.5 2.5 0 1 0 5 8.5a2.5 2.5 0 0 0-.02-5ZM3 9h4v12H3V9Zm6 0h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05C20.3 8.65 21 10.6 21 13.4V21h-4v-6.7c0-1.6-.03-3.66-2.23-3.66-2.23 0-2.57 1.74-2.57 3.54V21H9V9Z"/></svg></a>
        <a href="#" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></a>
        <a href="#" aria-label="X"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.5 3h3l-7 8 8.2 10h-6.4l-5-6.1L8 21H5l7.5-8.6L4.5 3H11l4.5 5.5L17.5 3Z"/></svg></a>
        <a href="#" aria-label="YouTube"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M22 12s0-3.2-.4-4.7a2.5 2.5 0 0 0-1.8-1.8C18.3 5 12 5 12 5s-6.3 0-7.8.5A2.5 2.5 0 0 0 2.4 7.3C2 8.8 2 12 2 12s0 3.2.4 4.7c.3 1 .9 1.6 1.8 1.8C5.7 19 12 19 12 19s6.3 0 7.8-.5a2.5 2.5 0 0 0 1.8-1.8C22 15.2 22 12 22 12Zm-12 3V9l5.2 3-5.2 3Z"/></svg></a>
      </div>
    </div>
    <div class="ft-col">
      <h4>Explore</h4>
      <div class="ft-contact">
        {footer.explore_links.map((l) => (<a href={l.href}>{l.label}</a>))}
      </div>
    </div>
    <div class="ft-col">
      <h4>Contact</h4>
      <div class="ft-contact">
        <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7-5.6-7-11a7 7 0 0 1 14 0c0 5.4-7 11-7 11Z"/><circle cx="12" cy="10" r="2.5"/></svg>{c.address}</span>
        <a href={`mailto:${c.email}`}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>{c.email}</a>
        <a href={c.phone_href}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.6A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"/></svg>{c.phone}</a>
      </div>
    </div>
  </div>
  <div class="ft-bottom">
    <span>{footer.copyright}</span>
    <span><a href="#">Privacy</a> &nbsp;·&nbsp; <a href="#">Terms</a></span>
  </div>
</footer>
