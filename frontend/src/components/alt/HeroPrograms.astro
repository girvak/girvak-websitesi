---
import { Image } from 'astro:assets';
import type { Hero } from '../../lib/types';
import { resolveImage } from '../../lib/images';
import programs from '../../data/active_programs.json';

interface Program {
  name: string;
  initials: string;
  status: 'open' | 'ongoing' | 'closing';
  status_label: string;
  deadline: string;
  days_left: number | null;
  detail: string;
  color: string;
  href: string;
  images: string[];
}

interface Props {
  hero: Hero;
}

const { hero } = Astro.props;
const list = programs as Program[];
const statusClass = {
  open: 'pf-open',
  ongoing: 'pf-ongoing',
  closing: 'pf-closing',
} as const;
const defaultActive = 1;
const openCount = list.filter((p) => p.status === 'open').length;
const firstWord = hero.rotator_words[0] ?? '';
---

<section class="alt-hero" id="top">
  <div class="alt-hero-shell wrap">
    <div class="alt-hero-align">
      <div class="alt-hero-left">
        <p class="alt-hero-eyebrow">
          <span class="alt-hero-live" aria-hidden="true"></span>
          {openCount} programs open now
        </p>

        <h1 class="alt-hero-title">
          <span class="hero-base" id="heroBase">{hero.base_text}</span><span
            class="hero-rotator"
            id="heroRotator"
            data-words={JSON.stringify(hero.rotator_words)}
            aria-hidden="true"
          ></span><span class="sr-only">{firstWord}.</span>
        </h1>

        <p class="alt-hero-sub">
          {hero.subhead_pre}<span class="alt-hero-hl">{hero.subhead_highlight}</span>{hero.subhead_post}
        </p>

        <div class="alt-hero-actions">
          {hero.ctas.map((cta, i) => (
            <a
              href={cta.href}
              class={`alt-btn ${i === 0 ? 'alt-btn-primary' : 'alt-btn-ghost'}`}
            >
              {cta.label}<span class="cta-arrow" aria-hidden="true"></span>
            </a>
          ))}
        </div>
      </div>

      <div class="alt-hero-right" id="programs">
        <div class="alt-program-gallery" id="programGallery">
          {list.map((program, pIdx) => (
            <div
              class={`alt-gallery-set acc-${program.color}${pIdx === defaultActive ? ' is-active' : ''}`}
              data-program={pIdx}
            >
              <div class="alt-gallery-photos">
                {program.images.map((src, imgIdx) => {
                  const meta = resolveImage(src);
                  return (
                    <figure class={`alt-gallery-photo p${imgIdx + 1}`}>
                      {meta ? (
                        <Image
                          src={meta}
                          alt={`${program.name} — photo ${imgIdx + 1}`}
                          width={imgIdx === 0 ? 460 : 340}
                          densities={[1, 2]}
                          format="webp"
                          loading={pIdx === defaultActive && imgIdx === 0 ? 'eager' : 'lazy'}
                        />
                      ) : (
                        <img src={src} alt={`${program.name} — photo ${imgIdx + 1}`} loading="lazy" decoding="async" />
                      )}
                    </figure>
                  );
                })}
              </div>
            </div>
          ))}
        </div>

        <div class="alt-picker-stage" id="pickerStage" role="group" aria-label="Explore programs — use arrow keys or hover">
          <div class="alt-picker-track" id="pickerTrack">
            {list.map((program, i) => {
              const thumb = resolveImage(program.images[0]);
              return (
                <a
                  href={program.href}
                  class={`alt-picker-card acc-${program.color}${i === defaultActive ? ' slot-active' : ''}`}
                  data-index={i}
                >
                  <div class="alt-program-accent" aria-hidden="true"></div>
                  <div class="alt-picker-thumb" aria-hidden="true">
                    {thumb ? (
                      <Image src={thumb} alt="" width={64} height={64} densities={[1, 2]} format="webp" loading="lazy" />
                    ) : (
                      <span class="alt-program-placeholder">{program.initials}</span>
                    )}
                  </div>
                  <div class="alt-picker-body">
                    <div class="alt-program-top">
                      <h3 class="alt-program-name">{program.name}</h3>
                      <span class={`alt-program-status ${statusClass[program.status]}`}>
                        {program.status_label}
                      </span>
                    </div>
                    <p class="alt-program-deadline">
                      {program.deadline}
                      {program.days_left !== null && (
                        <span class="alt-program-days"> · {program.days_left}d left</span>
                      )}
                    </p>
                    <p class="alt-program-detail">{program.detail}</p>
                  </div>
                  <span class="alt-program-arrow cta-arrow" aria-hidden="true"></span>
                </a>
              );
            })}
          </div>
        </div>

        <div class="alt-picker-dots" id="pickerDots" role="tablist" aria-label="Programs">
          {list.map((program, i) => (
            <button
              type="button"
              class={`alt-picker-dot${i === defaultActive ? ' is-active' : ''}`}
              data-dot={i}
              role="tab"
              aria-selected={i === defaultActive ? 'true' : 'false'}
              aria-label={program.name}
            ></button>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
