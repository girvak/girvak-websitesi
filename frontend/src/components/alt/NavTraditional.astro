---
const links = [
  { label: 'about', href: '#' },
  { label: 'fellow program', href: '#' },
  { label: 'programs', href: '#programs' },
  { label: 'giveback', href: '#' },
  { label: 'get involved', href: '#' },
];
---

<header class="alt-nav" id="altNav">
  <div class="alt-nav-in wrap">
    <a href="/" class="alt-nav-logo" aria-label="GİRVAK">
      <img src="/assets/logo-primary-turquoise.png" alt="GİRVAK" width="150" height="35" />
    </a>

    <nav class="alt-nav-links" aria-label="Primary">
      {links.map((link) => (
        <a href={link.href} class="alt-nav-link">{link.label}</a>
      ))}
    </nav>

    <a href="#" class="alt-nav-cta">apply</a>

    <button class="alt-nav-toggle" id="altNavToggle" aria-label="Toggle menu" aria-expanded="false">
      <span></span>
      <span></span>
    </button>
  </div>

  <div class="alt-nav-mobile" id="altNavMobile" aria-hidden="true">
    {links.map((link) => (
      <a href={link.href}>{link.label}</a>
    ))}
    <a href="#" class="alt-nav-mobile-cta">apply</a>
  </div>
</header>
