---
// Full-page turquoise overlay menu. `pathPrefix` makes the home in-page anchors
// resolve correctly from any page: '' on the home page (same-page `#wwd`), '/'
// on sub-pages (`/#wwd`). Links to pages not yet built point to "#" placeholders.
interface Props {
  pathPrefix?: string;
}
const { pathPrefix = '' } = Astro.props;
const home = (hash: string) => `${pathPrefix}${hash}`;
---
<div class="navmenu" id="navmenu" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Site menu">
  <div class="navmenu-bar">
    <a href={home('#top')} class="navmenu-logo" aria-label="GİRVAK">
      <img src="/assets/logo-white.png" alt="GİRVAK" />
    </a>
    <button class="navmenu-close" id="menuClose" aria-label="Close menu">
      close <span class="nm-x" aria-hidden="true"></span>
    </button>
  </div>
  <nav class="navmenu-acc" aria-label="Primary">
    <ul class="nm-list">
      <li class="nm-item">
        <a href="/about" class="nm-head">about</a>
        <div class="nm-sub"><div class="nm-sub-inner">
          <a href="/about">about us</a>
          <a href="/about#trustees">board of trustees (preview)</a>
          <a href="/board-of-trustees">full board of trustees</a>
          <a href="/about#directors">board of directors</a>
          <a href="/about#team">our team</a>
          <a href="/about#reports">reports &amp; publications</a>
          <a href="/about#work">work with us</a>
        </div></div>
      </li>
      <li class="nm-item">
        <a href="/fellow-program" class="nm-head">fellow program</a>
        <div class="nm-sub"><div class="nm-sub-inner">
          <a href="/fellow-program">about</a>
          <a href="/fellow-program#fellows">fellows</a>
          <a href="/fellow-program#alumni">alumni</a>
          <a href="/fellow-program#challengers">challenger program</a>
          <a href="#">apply</a>
        </div></div>
      </li>
      <li class="nm-item">
        <a href={home('#wwd')} class="nm-head">programs &amp; projects</a>
        <div class="nm-sub"><div class="nm-sub-inner">
          <a href={home('#wwd')}>current programs &amp; projects</a>
          <a href="#">past programs &amp; projects</a>
          <a href="#">insights / reports</a>
        </div></div>
      </li>
      <li class="nm-item">
        <a href="#" class="nm-head">giveback</a>
        <div class="nm-sub"><div class="nm-sub-inner">
          <a href="#">giveback gala</a>
          <a href="#">can dörtkardeşler award</a>
          <a href="#">scholarship funds</a>
          <a href="#">events</a>
        </div></div>
      </li>
      <li class="nm-item">
        <a href="#" class="nm-head">investing</a>
        <div class="nm-sub"><div class="nm-sub-inner">
          <a href="#">founder one</a>
        </div></div>
      </li>
      <li class="nm-item">
        <a href={home('#partners')} class="nm-head">get involved</a>
        <div class="nm-sub"><div class="nm-sub-inner">
          <a href={home('#partners')}>ways to partner</a>
          <a href="#">scholarship funds</a>
        </div></div>
      </li>
      <li class="nm-item nm-item-apply">
        <a href="#" class="nm-head nm-apply">apply</a>
      </li>
    </ul>
  </nav>
</div>
