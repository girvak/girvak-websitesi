---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import NavMenu from '../components/NavMenu.astro';
import Footer from '../components/Footer.astro';
import FellowFlipBelt from '../components/fellow/FellowFlipBelt.astro';
import ChallengerBelt from '../components/fellow/ChallengerBelt.astro';
import { resolveImage } from '../lib/images';
import { getFellowContent, getHomeContent, getPeople } from '../lib/content';
import { sortPeopleAlpha } from '../lib/aboutPeople';
import '../styles/fellow.css';

const content = await getHomeContent();
const peopleApi = await getPeople();
// Page copy + section media: Airtable `fellow` table (tag families).
// People belts: Airtable `people` table (tags fellow / alumni / challenger).
const fp = await getFellowContent();
const apiBase = import.meta.env.PUBLIC_API_BASE_URL ?? 'http://localhost:8000';

const seo = {
  title: 'Fellow Program · GİRVAK',
  description:
    fp.about_html?.replace(/<[^>]+>/g, '').slice(0, 160) ||
    'A community that backs you. For life. The GİRVAK Fellow Program equips young people with an entrepreneurial mindset to drive change.',
};

// Airtable returns records in table order — sort like the about / trustees
// grids so every people list on the site reads alphabetically (Turkish locale).
const fellowPeople = sortPeopleAlpha(peopleApi?.fellows?.length ? peopleApi.fellows : []);
const alumniPeople = sortPeopleAlpha(peopleApi?.alumni?.length ? peopleApi.alumni : []);
const challengerPeople = sortPeopleAlpha(peopleApi?.challengers?.length ? peopleApi.challengers : []);

const isRemote = (s: string) => /^https?:\/\//.test(s);

const heroRemote = fp.hero_image && isRemote(fp.hero_image) ? fp.hero_image : '';
const heroLocal =
  (!heroRemote && fp.hero_image ? resolveImage(fp.hero_image) : undefined) ??
  resolveImage('/images/fellow-group.png') ??
  resolveImage('/images/fellow-cutout.png');

const wte = fp.what_to_expect.map((c) => {
  const remote = c.image && isRemote(c.image) ? c.image : '';
  const meta = !remote && c.image ? resolveImage(c.image) : undefined;
  return { ...c, remote, meta };
});

const chalRemote = fp.challenger_hero_image && isRemote(fp.challenger_hero_image) ? fp.challenger_hero_image : '';
const chalPhoto =
  (!chalRemote && fp.challenger_hero_image ? resolveImage(fp.challenger_hero_image) : undefined) ??
  resolveImage('/images/chal-program.jpg') ??
  resolveImage('/images/wd-development.jpg');

// Airtable's challenger "how we select" rows carry no **_highlight_** markers,
// so the phrases arrive as plain text and render dark on the amber panel. The
// copy is identical to the fellow rows, which do carry them — borrow the
// marked-up variant when the plain text matches, otherwise render as-is.
const stripTags = (s: string) => s.replace(/<[^>]+>/g, '');
const markedSelection = new Map(fp.selection.paragraphs.map((p) => [stripTags(p), p]));
const chalSelectionParagraphs = fp.challenger_selection.paragraphs.map(
  (p) => markedSelection.get(stripTags(p)) ?? p,
);

const fwyd = fp.what_youll_do.map((i) => ({
  ...i,
  meta: i.image && !isRemote(i.image) ? resolveImage(i.image) : undefined,
  remote: i.image && isRemote(i.image) ? i.image : '',
}));
---

<BaseLayout title={seo.title} description={seo.description} bodyClass="hm fp">
  <Nav logoHref="/" scrolled />
  <NavMenu pathPrefix="/" />

  <main>
    <!-- PINNED HERO -->
    <section class="fhero-track">
      <div class="fhero-pin">
        <div class="fhero-media">
          {heroRemote ? (
            <img class="fhero-photo" src={heroRemote} alt="GİRVAK Fellows" loading="eager" decoding="async" />
          ) : heroLocal ? (
            <Image class="fhero-photo" src={heroLocal} alt="GİRVAK Fellows" widths={[560, 1120]} sizes="(max-width: 900px) 92vw, 44vw" />
          ) : (
            <img class="fhero-photo" src="/images/fellow-group.png" alt="GİRVAK Fellows" />
          )}
        </div>

        <div class="fhero-left">
          <div class="fhero-state fhero-1 on">
            <h1 class="fhero-h1" set:html={fp.hero_headline_html || fp.hero_headline} />
            <div class="fhero-links">
              <a class="fhero-link" href={fp.hero_cta_primary.href}><span class="fhero-link-label">{fp.hero_cta_primary.label}</span><span class="arr" aria-hidden="true"></span></a>
              <a class="fhero-link" href={fp.hero_cta_secondary.href}><span class="fhero-link-label">{fp.hero_cta_secondary.label}</span><span class="arr" aria-hidden="true"></span></a>
            </div>
          </div>

          <div class="fhero-state fhero-2 off">
            <p class="fhero-copy" set:html={fp.about_html} />
          </div>
        </div>
      </div>
    </section>

    <!-- APPLICATION CRITERIA & SELECTION -->
    <section class="fhow">
      <div class="fhow-row">
        <p class="fhow-label" style="font-weight: 400; color: rgb(255, 255, 255)">{fp.application.label}</p>
        <div class="fhow-body">
          {fp.application.paragraphs.map((p) => <p set:html={p} />)}
          {fp.application.kicker && <p class="kicker" style="font-weight: 700">{fp.application.kicker}</p>}
        </div>
      </div>
      <div class="fhow-row">
        <p class="fhow-label" style="font-weight: 400; color: rgb(255, 255, 255)">{fp.selection.label}</p>
        <div class="fhow-body">
          {fp.selection.paragraphs.map((p) => <p set:html={p} />)}
          {fp.selection.kicker && <p class="kicker">{fp.selection.kicker}</p>}
        </div>
      </div>
    </section>

    <!-- WHAT TO EXPECT -->
    <section class="fwte">
      <h2 class="fwte-title">{fp.what_to_expect_headline}</h2>
      <div class="fwte-grid">
        {wte.map((c) => (
          <div class={`fwte-card ${c.cap}`}>
            {c.remote ? (
              <img src={c.remote} alt={c.name} loading="lazy" decoding="async" />
            ) : c.meta ? (
              <Image src={c.meta} alt={c.name} widths={[400, 800]} sizes="(max-width: 720px) 50vw, 33vw" />
            ) : c.image ? (
              <img src={c.image} alt={c.name} loading="lazy" decoding="async" />
            ) : null}
            <div class="fwte-cap">
              <p class="fwte-name">{c.name}</p>
              <p class="fwte-desc">{c.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- FELLOWS MARQUEE -->
    <section class="fellows ffellows" id="fellows">
      <div class="fellows-head">
        <h2 class="ffellows-h2">{fp.fellows_headline}</h2>
        <a href={fp.fellows_cta.href} class="h3btn ffellows-seeall"><span class="h3btn-label">{fp.fellows_cta.label}</span><span class="cta-arrow" aria-hidden="true"></span></a>
      </div>

      {
        fellowPeople.length > 0 ? (
          <FellowFlipBelt
            trackId="belt"
            people={fellowPeople}
            cardClass="fc-fellow"
            ariaLabel={fp.fellows_headline || 'Meet the fellows'}
          />
        ) : (
          <p class="fchallengers-empty">Fellow profiles coming soon.</p>
        )
      }
    </section>

    <!-- ONCE A FELLOW / ALUMNI -->
    <section class="falum" id="alumni">
      <h2 class="falum-h2" set:html={fp.alumni_headline_html || fp.alumni_headline} />
      <p class="falum-intro">{fp.alumni_intro}</p>
      <div class="falum-row">
        <p class="falum-label">{fp.alumni_label}</p>
        <div class="falum-body">
          {fp.alumni_bullets.map((b) => <p>{b}</p>)}
        </div>
      </div>
      {
        alumniPeople.length > 0 ? (
          <section class="fellows ffellows falum-belt">
            <div class="fellows-head">
              <h2 class="ffellows-h2">{fp.alumni_cta.label}</h2>
              <a href={fp.alumni_cta.href} class="h3btn ffellows-seeall falum-seeall"><span class="h3btn-label">see all</span><span class="cta-arrow" aria-hidden="true"></span></a>
            </div>
            <FellowFlipBelt
              trackId="abelt"
              people={alumniPeople}
              cardClass="fc-alumni"
              ariaLabel={fp.alumni_cta.label}
            />
          </section>
        ) : (
          <div class="falum-foot">
            <a href={fp.alumni_cta.href} class="fhero-link falum-cta"><span class="fhero-link-label">{fp.alumni_cta.label}</span><span class="arr" aria-hidden="true"></span></a>
          </div>
        )
      }
    </section>

    <!-- IMPACT / BECAUSE -->
    <section class="fbecause">
      <div class="fbecause-inner">
        <h2 class="fbecause-h2" set:html={fp.giveback_headline_html || fp.giveback_headline} />
        <div class="fbecause-copy">
          <p class="fbecause-lead">{fp.giveback_lead}</p>
          <p>{fp.giveback_body}</p>
          <a class="fbecause-report" href={fp.giveback_cta.href}><span class="fbecause-report-label">{fp.giveback_cta.label}</span><span class="arr" aria-hidden="true"></span></a>
        </div>
      </div>
    </section>

    <!-- CHALLENGER PROGRAM -->
    <section class="fchal">
      <h2 class="fchal-h2" set:html={fp.challenger_hero_headline_html || fp.challenger_hero_headline} />
      <div class="fchal-row">
        <div class="fchal-media">
          {chalRemote ? (
            <img src={chalRemote} alt="Challenger Program students" loading="lazy" decoding="async" />
          ) : chalPhoto ? (
            <Image src={chalPhoto} alt="Challenger Program students" widths={[500, 1000]} sizes="(max-width: 760px) 100vw, 50vw" />
          ) : (
            <img src="/images/chal-program.jpg" alt="Challenger Program students" />
          )}
        </div>
        <div class="fchal-content">
          <div class="fchal-copy">
            {fp.challenger_paragraphs.map((p) => (
              <p set:html={p} />
            ))}
          </div>
          <div class="fchal-links">
            <a class="fhero-link fchal-link" href={fp.challenger_cta_primary.href}><span class="fhero-link-label">{fp.challenger_cta_primary.label}</span><span class="arr" aria-hidden="true"></span></a>
            <a class="fhero-link fchal-link" href={fp.challenger_cta_secondary.href}><span class="fhero-link-label">{fp.challenger_cta_secondary.label}</span><span class="arr" aria-hidden="true"></span></a>
          </div>
        </div>
      </div>
    </section>

    <!-- CHALLENGER — APPLY & SELECT -->
    <section class="fchow">
      <div class="fhow-row">
        <p class="fhow-label">{fp.challenger_application.label}</p>
        <div class="fhow-body">
          {fp.challenger_application.paragraphs.map((p) => <p set:html={p} />)}
          {fp.challenger_application.kicker && <p class="kicker">{fp.challenger_application.kicker}</p>}
        </div>
      </div>
      <div class="fhow-row">
        <p class="fhow-label">{fp.challenger_selection.label}</p>
        <div class="fhow-body">
          {chalSelectionParagraphs.map((p) => (
            <p set:html={p} />
          ))}
          {fp.challenger_selection.kicker && <p class="kicker">{fp.challenger_selection.kicker}</p>}
        </div>
      </div>
    </section>

    <!-- CHALLENGER — WHAT YOU'LL DO -->
    <section class="fwyd">
      <h2 class="fwyd-title">{fp.what_youll_do_headline}</h2>
      <div class="fwyd-grid">
        {fwyd.map((i) => (
          <div class="fwyd-item">
            {i.remote ? (
              <img src={i.remote} alt="" width="196" height="196" loading="lazy" decoding="async" />
            ) : i.meta ? (
              <Image src={i.meta} alt="" width={196} height={196} />
            ) : i.image ? (
              <img src={i.image} alt="" width="196" height="196" loading="lazy" decoding="async" />
            ) : null}
            <p>{i.text}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- MEET THE CHALLENGERS -->
    <section class="fchallengers ffellows" id="challengers">
      <div class="fellows-head">
        <h2 class="ffellows-h2">{fp.challengers_headline}</h2>
        <a href={fp.challengers_cta.href} class="h3btn ffellows-seeall fchal-seeall"><span class="h3btn-label">{fp.challengers_cta.label}</span><span class="cta-arrow" aria-hidden="true"></span></a>
      </div>
      {
        challengerPeople.length > 0 ? (
          <ChallengerBelt
            trackId="cbelt"
            people={challengerPeople}
            ariaLabel="Meet the challengers"
          />
        ) : (
          <p class="fchallengers-empty">Challenger profiles coming soon.</p>
        )
      }
    </section>
  </main>

  <Footer footer={content.footer} apiBase={apiBase} />
</BaseLayout>

<script>
  import '../scripts/home.js';
  import '../scripts/fellow.js';
</script>
