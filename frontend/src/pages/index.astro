---
// Original GİRVAK homepage (design index.html) — the canonical site root.
// The alternative program-first homepage now lives at /alt.
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import NavMenu from '../components/NavMenu.astro';
import Hero from '../components/Hero.astro';
import ImpactMosaic from '../components/ImpactMosaic.astro';
import WhatWeDo from '../components/WhatWeDo.astro';
import FellowFlipBelt from '../components/fellow/FellowFlipBelt.astro';
import TrusteeBelt from '../components/TrusteeBelt.astro';
import Partners from '../components/Partners.astro';
import Footer from '../components/Footer.astro';
import OpenCallsPopup from '../components/OpenCallsPopup.astro';
import { getApply, getHomeContent, getPeople } from '../lib/api';
import type { OpenCall } from '../lib/types';
import { publicApiBase } from '../lib/env';
import { shuffled } from '../lib/shuffle';

// Rendered per request: an Airtable edit shows up on the next reload, with no
// build step. Both calls hit the API's snapshot, so this is one round trip each
// at most once per cache window.
const [content, peopleApi] = await Promise.all([getHomeContent(), getPeople()]);
// The popup is extra: if the calls cannot be read, the home page still renders,
// just without it.
const popupSource: OpenCall[] = await getApply().then((apply) => apply.calls, () => []);
const { seo, hero, impact, impact_image, what_we_do, fellows_headline, fellows_cta, partners, footer } = content;
const apiBase = publicApiBase;

// Shuffle + teal/coral/ink rotate — the belt should feel fresh on every load.
const fellowSpotlight = shuffled(peopleApi.fellows.filter((p) => p.photo)).slice(0, 8);
// MH — Mütevelli Heyeti, the board of trustees (people tagged `mh`) — shuffled like every list.
const trusteeSpotlight = shuffled(peopleApi.trustees.filter((p) => p.photo)).slice(0, 12);
Astro.response.headers.set('Cache-Control', 'no-store');

---

<BaseLayout title={seo.title} description={seo.description}>
  <Nav />
  <NavMenu />
  <Hero hero={hero} />
  <ImpactMosaic impact={impact} impactImage={impact_image ?? '/images/impact-photo.jpg'} />
  <WhatWeDo cards={what_we_do} />
  {
    trusteeSpotlight.length > 0 ? (
      <section class="fellows trustees" id="trustees">
        <div class="fellows-head rv" style="font-weight: 600">
          <div>
            <h2 class="h2 fellows-title">our board of trustees</h2>
          </div>
          <a href="/board-of-trustees" class="h3btn"><span class="h3btn-label">see all</span><span class="cta-arrow" aria-hidden="true"></span></a>
        </div>
        <TrusteeBelt people={trusteeSpotlight} ariaLabel="Our board of trustees" />
      </section>
    ) : null
  }
  <section class="fellows" id="fellows">
    <div class="fellows-head rv" style="font-weight: 600">
      <div>
        <h2 class="h2 fellows-title">{fellows_headline ?? 'meet our fellows'}</h2>
      </div>
      <a href={fellows_cta?.href ?? '/fellows'} class="h3btn"><span class="h3btn-label">{fellows_cta?.label ?? 'see all fellows'}</span><span class="cta-arrow" aria-hidden="true"></span></a>
    </div>
    {
      fellowSpotlight.length > 0 ? (
        <FellowFlipBelt
          trackId="belt"
          people={fellowSpotlight}
          cardClass="fc-teal"
          ariaLabel="Meet our fellows"
          spotlightFetch
          colorRotate
          programBack
        />
      ) : null
    }
  </section>
  <Partners partners={partners} />
  <Footer footer={footer} apiBase={apiBase} />
  <OpenCallsPopup calls={popupSource} />
</BaseLayout>

<script>
  import '../scripts/home.js';
  import '../scripts/popup.js';
</script>
