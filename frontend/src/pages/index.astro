---
// Original GİRVAK homepage (design index.html) — the canonical site root.
// The alternative program-first homepage now lives at /alt.
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import NavMenu from '../components/NavMenu.astro';
import Hero from '../components/Hero.astro';
import ImpactMosaic from '../components/ImpactMosaic.astro';
import WhatWeDo from '../components/WhatWeDo.astro';
import FellowFlipBelt from '../components/fellow/FellowFlipBelt.astro';
import Partners from '../components/Partners.astro';
import Footer from '../components/Footer.astro';
import { getHomeContent, getPeople } from '../lib/api';
import { publicApiBase } from '../lib/env';

// Rendered per request: an Airtable edit shows up on the next reload, with no
// build step. Both calls hit the API's snapshot, so this is one round trip each
// at most once per cache window.
const [content, peopleApi] = await Promise.all([getHomeContent(), getPeople()]);
const { seo, hero, impact, impact_image, what_we_do, fellows_headline, fellows_cta, partners, footer } = content;
const apiBase = publicApiBase;

const fellowSpotlight = peopleApi.fellows.filter((p) => p.photo).slice(0, 8);

/** Emphasise "fellow(s)" in the homepage belt heading with the program red. */
function fellowsHeadlineHtml(text: string): string {
  const m = text.match(/^(.*?)(\bfellows?\b)(.*)$/i);
  if (!m) return text;
  return `${m[1]}<span class="fellows-hl">${m[2]}</span>${m[3]}`;
}
---

<BaseLayout title={seo.title} description={seo.description}>
  <Nav />
  <NavMenu />
  <Hero hero={hero} />
  <ImpactMosaic impact={impact} impactImage={impact_image ?? '/images/impact-photo.jpg'} />
  <WhatWeDo cards={what_we_do} />
  <section class="fellows" id="fellows">
    <div class="fellows-head rv" style="font-weight: 600">
      <div>
        <h2 class="h2 fellows-title" set:html={fellowsHeadlineHtml(fellows_headline ?? 'meet our fellows')} />
      </div>
      <a href={fellows_cta?.href ?? '/fellows'} class="h3btn"><span class="h3btn-label">{fellows_cta?.label ?? 'see all fellows'}</span><span class="cta-arrow" aria-hidden="true"></span></a>
    </div>
    {
      fellowSpotlight.length > 0 ? (
        <FellowFlipBelt
          trackId="belt"
          people={fellowSpotlight}
          cardClass="fc-fellow"
          ariaLabel="Meet our fellows"
          spotlightFetch
          programBack
        />
      ) : null
    }
  </section>
  <Partners partners={partners} />
  <Footer footer={footer} apiBase={apiBase} />
</BaseLayout>

<script>
  import '../scripts/home.js';
</script>
