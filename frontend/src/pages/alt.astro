---
// Alternative, program-first homepage — kept as a second homepage at /alt.
// The original/canonical homepage lives at / (see index.astro).
import AltLayout from '../layouts/AltLayout.astro';
import NavTraditional from '../components/alt/NavTraditional.astro';
import HeroPrograms from '../components/alt/HeroPrograms.astro';
import { getHomeContent } from '../lib/content';

const content = await getHomeContent();
const { seo, hero } = content;
---

<AltLayout title={seo.title} description={seo.description}>
  <NavTraditional />
  <HeroPrograms hero={hero} />
</AltLayout>

<script>
  import '../scripts/alt-home.js';
</script>
