---
// Deliberately content-free: a 404 must render when the content API does not
// answer, so it imports the global stylesheet and nothing else.
import '../styles/styles.css';
import '../styles/about.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sayfa bulunamadı · GİRVAK</title>
    <meta name="robots" content="noindex" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,400;0,600;0,700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="hm ab">
    <main>
      <section class="ab-hero ab-hero--home ab-hero--compact">
        <div class="ab-hero-in">
          <h1 class="ab-hero-title ab-hero-title--page">Sayfa bulunamadı</h1>
          <p class="ab-hero-sub">Aradığınız sayfa taşınmış ya da hiç var olmamış olabilir.</p>
          <a class="h3btn" href="/">
            <span class="h3btn-label">anasayfaya dön</span>
            <span class="cta-arrow" aria-hidden="true"></span>
          </a>
        </div>
      </section>
    </main>
  </body>
</html>
