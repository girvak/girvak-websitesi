---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import NavMenu from '../components/NavMenu.astro';
import Footer from '../components/Footer.astro';
import PeopleGrid from '../components/about/PeopleGrid.astro';
import { isUnbundled, resolveImage } from '../lib/images';
import { getAboutContent, getHomeContent, getPeople } from '../lib/api';
import { publicApiBase } from '../lib/env';
import '../styles/about.css';

const TRUSTEES_PREVIEW = 10; // 2 rows × 5 columns on desktop

const [content, about, livePeople] = await Promise.all([
  getHomeContent(),
  getAboutContent(),
  getPeople(),
]);
const apiBase = publicApiBase;

// Order is the API's: Turkish alphabetical, board chair and vice-chair first.
// Sorting again here would be a second, divergent rule.
const trusteesAll = livePeople.trustees;
const directorsData = livePeople.directors;
const teamData = livePeople.team;
const trusteesPreview = trusteesAll.slice(0, TRUSTEES_PREVIEW);

const isRemote = isUnbundled;
const missionLocal = about.mission.image && !isRemote(about.mission.image)
  ? resolveImage(about.mission.image)
  : undefined;
const missionRemote = about.mission.image && isRemote(about.mission.image) ? about.mission.image : undefined;

// Mission headline is plain text from backend; emphasize "entrepreneurship"
// as blue + italic by wrapping it in <em>.
const missionHeadlineHtml = (() => {
  const s = about.mission.headline ?? '';
  // If backend already sent HTML, don't double-inject.
  if (s.includes('<')) return s;
  const normalized = s.replace(/\s+/g, ' ').trim();
  if (/^to remove the structural barriers that limit access to entrepreneurship in türkiye\.?$/i.test(normalized)) {
    return '<span class="ab-mission-line1">To remove the structural barriers that</span><br /><span class="ab-mission-line2">limit access to <em>entrepreneurship</em> in&nbsp;Türkiye.</span>';
  }
  const withBreak = normalized.replace(/that limit access to\s+/i, 'that limit access to<br />');
  const withAccent = withBreak.replace(/entrepreneurship/gi, (m) => `<em>${m}</em>`);
  return withAccent.replace(/\bin Türkiye\b/gi, 'in&nbsp;Türkiye');
})();
---

<BaseLayout title={about.seo_title} description={about.seo_description} bodyClass="hm ab">
  <Nav logoHref="/" scrolled />
  <NavMenu pathPrefix="/" />

  <main>
    <section class="ab-hero ab-hero--home" style="padding: 172px 0px 39px">
      <div class="ab-hero-in" style="padding: 80px var(--edge) 0px">
        <h1 class="ab-hero-title" set:html={about.hero_html} />
      </div>
    </section>

    <section class="ab-block" id="aboutus" style="padding: 50px var(--edge) 70px">
      <div class="ab-body">
        {about.about_paragraphs.map((p) => (
          <p style="width: auto; color: rgb(55, 61, 66)">{p}</p>
        ))}
      </div>
    </section>

    <section class="ab-photo" id="mission">
      {missionLocal ? (
        <Image class="ab-photo-img" src={missionLocal} alt="" widths={[960, 1600, 2048]} sizes="100vw" loading="eager" fetchpriority="high" />
      ) : missionRemote ? (
        <img class="ab-photo-img" src={missionRemote} alt="" loading="eager" decoding="async" />
      ) : (
        <img class="ab-photo-img" src="/images/about-audience.jpg" alt="" />
      )}
      <div class="ab-photo-in">
        <div class="ab-pk">{about.mission.kicker}</div>
        <h2 set:html={missionHeadlineHtml} />
      </div>
    </section>
    <div class="ab-photo-spacer"></div>

    <section class="ab-story" id="story" style="padding: 20px var(--edge) 81px">
      <div class="ab-story-head">
        <h2>{about.story_headline}</h2>
      </div>
      <div class="ab-story-body">
        {about.story_paragraphs.map((p) => (
          <p style="width: auto; color: rgb(55, 61, 66)" set:html={p} />
        ))}
      </div>
    </section>

    <section class="wwd wws" id="wws" style="padding: 2px 0px 104px">
      <div class="wwd-head" style="font-weight: 600">
        <h2 class="h2" style="color: #373d42; margin: 0; text-align: left">
          <span style="color: #373d42">{about.what_we_solve_headline}</span>
        </h2>
      </div>
      <div class="wss-strips" id="wwsRows">
        {about.what_we_solve_strips.map((strip) => {
          const local = strip.image && !isRemote(strip.image) ? resolveImage(strip.image) : undefined;
          const remote = strip.image && isRemote(strip.image) ? strip.image : undefined;
          return (
            <a class="wss-strip" style={`--ov:${strip.overlay_color}`} href={strip.href || '#'}>
              {local ? (
                <Image class="wss-photo" src={local} alt="" widths={[800, 1400]} sizes="100vw" />
              ) : remote ? (
                <img class="wss-photo" src={remote} alt="" loading="lazy" decoding="async" />
              ) : (
                <img class="wss-photo" src={strip.image} alt="" loading="lazy" decoding="async" />
              )}
              <span class="wss-label">{strip.label}</span>
              <div class="wss-overlay" style={`background-color: ${strip.overlay_color}`}>
                <span class="wss-headline">{strip.headline}</span>
                <span class="wss-desc">{strip.desc}</span>
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <section class="people tint" id="trustees">
      <div class="people-head">
        <h2>{about.trustees.headline}</h2>
        <p>{about.trustees.subheadline}</p>
      </div>
      <PeopleGrid id="trustees-grid" people={trusteesPreview} forceColor="#373D42" />
      <div class="people-cta">
        <a class="h3btn" href="/board-of-trustees">
          <span class="h3btn-label">see all</span><span class="cta-arrow" aria-hidden="true"></span>
        </a>
      </div>
    </section>

    <section class="people alt" id="directors">
      <div class="people-head">
        <h2>{about.directors.headline}</h2>
        <p>{about.directors.subheadline}</p>
      </div>
      <PeopleGrid id="directors-grid" people={directorsData} forceColor="#F76C53" />
    </section>

    <section class="people" id="team">
      <div class="people-head">
        <h2>{about.team.headline}</h2>
        <p>{about.team.subheadline}</p>
      </div>
      <PeopleGrid id="team-grid" people={teamData} forceColor="#19BAD1" teamTone />
    </section>

    <section class="ab-work" id="reports">
      <div class="ab-work-in">
        <div class="ab-work-copy">
          <h2>{about.reports.headline}</h2>
          <p>{about.reports.text}</p>
        </div>
        <a class="h3btn" href={about.reports.cta_href}>
          <span class="h3btn-label">{about.reports.cta_label}</span><span class="cta-arrow" aria-hidden="true"></span>
        </a>
      </div>
    </section>

    <section class="ab-work" id="work">
      <div class="ab-work-in">
        <div class="ab-work-copy">
          <h2>{about.work_with_us.headline}</h2>
          <p>{about.work_with_us.text}</p>
        </div>
        <a class="h3btn" href={about.work_with_us.cta_href}>
          <span class="h3btn-label">{about.work_with_us.cta_label}</span><span class="cta-arrow" aria-hidden="true"></span>
        </a>
      </div>
    </section>
  </main>

  <Footer footer={content.footer} apiBase={apiBase} />
</BaseLayout>

<script>
  import '../scripts/home.js';
  import '../scripts/about.js';
</script>
