---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import NavMenu from '../components/NavMenu.astro';
import Footer from '../components/Footer.astro';
import PeopleGrid from '../components/about/PeopleGrid.astro';
import { getAboutContent, getHomeContent, getPeople } from '../lib/api';
import { publicApiBase } from '../lib/env';
import '../styles/about.css';

const [content, about, livePeople] = await Promise.all([
  getHomeContent(),
  getAboutContent(),
  getPeople(),
]);
const apiBase = publicApiBase;

// The API already ordered them (Turkish alphabetical).
const trusteesAll = livePeople.trustees;
---

<BaseLayout
  title={`${about.trustees.subheadline} · GİRVAK`}
  description="Full Board of Trustees of the Entrepreneurship Foundation of Türkiye (GİRVAK)."
  bodyClass="hm ab"
>
  <Nav logoHref="/" scrolled />
  <NavMenu pathPrefix="/" />

  <main>
    <section class="ab-hero ab-hero--home ab-hero--compact">
      <div class="ab-hero-in">
        <a class="ab-back" href="/about#trustees">← back to about</a>
        <h1 class="ab-hero-title ab-hero-title--page">{about.trustees.headline}</h1>
        <p class="ab-hero-sub">{about.trustees.subheadline}</p>
      </div>
    </section>

    <section class="people tint" id="trustees">
      <PeopleGrid id="trustees-grid-full" people={trusteesAll} forceColor="#373D42" />
    </section>
  </main>

  <Footer footer={content.footer} apiBase={apiBase} />
</BaseLayout>

<script>
  import '../scripts/home.js';
</script>
