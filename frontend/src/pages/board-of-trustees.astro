---
/**
 * Module: src/pages/board-of-trustees.astro
 * Layer: Page
 * Purpose: Every trustee. The same page as /fellows and /alumni — the hero, the
 *          filter bar (here the search alone), a flip card per person revealed
 *          24 at a time — in GİRVAK ink, with a link back to About underneath.
 *
 *          The words are the design's, written here — they do not come from
 *          Airtable. The people do: name, company, position, photo and LinkedIn
 *          on every card, are the `people` table's. No count is shown anywhere.
 *
 *          The design draws this page with the About page's card grid. It follows
 *          the other directories instead, so the site's people pages read as one.
 *
 * Called by: visitors at /board-of-trustees, and the "see all" on /about
 * Calls: src/lib/api.ts, src/components/PeopleDirectory.astro
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import NavMenu from '../components/NavMenu.astro';
import Footer from '../components/Footer.astro';
import PeopleDirectory from '../components/PeopleDirectory.astro';
import { getHomeContent, getPeople } from '../lib/api';
import { publicApiBase } from '../lib/env';
import '../styles/ventures.css';
import '../styles/directory.css';

const [content, people] = await Promise.all([getHomeContent(), getPeople()]);
const apiBase = publicApiBase;

// The API already ordered them (Turkish alphabetical).
const trustees = people.trustees;
---

<BaseLayout
  title="Board of Trustees · GİRVAK"
  description="Full Board of Trustees of the Entrepreneurship Foundation of Türkiye (GİRVAK)."
  bodyClass="hm ap fv fa bt"
>
  <Nav logoHref="/" scrolled />
  <NavMenu pathPrefix="/" />

  <PeopleDirectory
    variant="board"
    headlineHtml="Our Board of <i>Trustees</i>"
    introHtml="Those who choose to give back"
    people={trustees}
    noun="trustees"
  >
    <a slot="after" class="fa-back" href="/about">Back to About</a>
  </PeopleDirectory>

  <Footer footer={content.footer} apiBase={apiBase} />
</BaseLayout>

<script>
  import '../scripts/home.js';
</script>
