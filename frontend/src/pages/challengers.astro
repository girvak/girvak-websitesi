---
/**
 * Module: src/pages/challengers.astro
 * Layer: Page
 * Purpose: Every challenger as a row — name, university, department, cohort —
 *          filtered by the last three or found by name. Unlike the fellows and
 *          alumni pages there are no photos and no cards: the design draws this
 *          one as a plain list with a hand-drawn rule under each row. The
 *          filter bar, though, is the one every other showcase page has — the
 *          design put it in the list's header row, and it sits above it here.
 *
 *          Server-rendered like /founders-ventures: the rows and the dropdown
 *          choices are in the HTML, and the browser only toggles `hidden`.
 *
 * Called by: visitors at /challengers
 * Calls: src/lib/api.ts
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import NavMenu from '../components/NavMenu.astro';
import Footer from '../components/Footer.astro';
import { getHomeContent, getPeople } from '../lib/api';
import { publicApiBase } from '../lib/env';
import type { Person } from '../lib/types';
import '../styles/ventures.css';
import '../styles/directory.css';
import '../styles/challengers.css';

const [home, people] = await Promise.all([getHomeContent(), getPeople()]);
const apiBase = publicApiBase;

// The page's own words. Airtable has no copy table for this page, and the design
// fixes them, so they live here rather than in a seed nobody edits.
const seo = {
  title: 'All Challengers · GİRVAK',
  description: 'Meet the GİRVAK challengers discovering what drives them.',
};

/** Cohort key a row filters on: `’25` becomes `25`, matching the dropdown. */
const yearKey = (year: string | undefined): string => (year?.match(/\d/g) ?? []).join('').slice(-2);

/** The design prints challenger cohorts in full — `2025`, not `’25`. */
const yearLabel = (key: string): string => (key ? `20${key}` : '');

const nameOf = (p: Person): string => `${p.first} ${p.last ?? ''}`.trim();

// Newest cohort first. The API hands people over Turkish A–Z and `sort` is
// stable, so within a cohort that order is kept.
const challengers = [...people.challengers].sort(
  (a, b) => Number(yearKey(b.year) || -1) - Number(yearKey(a.year) || -1),
);

/** Distinct non-empty values, in Turkish alphabetical order. */
function distinct(pick: (p: Person) => string | undefined): string[] {
  const seen = new Set<string>();
  for (const p of challengers) {
    const v = pick(p)?.trim();
    if (v) seen.add(v);
  }
  return [...seen].sort((a, b) => a.localeCompare(b, 'tr'));
}

// Already newest first: `challengers` is sorted that way and Set keeps insertion order.
const yearKeys = [...new Set(challengers.map((p) => yearKey(p.year)).filter(Boolean))];

const filters = [
  {
    key: 'university',
    label: 'university',
    all: 'all universities',
    options: distinct((p) => p.university).map((v) => ({ value: v, label: v })),
  },
  {
    key: 'department',
    label: 'department',
    all: 'all departments',
    options: distinct((p) => p.department).map((v) => ({ value: v, label: v })),
  },
  {
    key: 'year',
    label: 'year',
    all: 'all years',
    options: yearKeys.map((k) => ({ value: k, label: yearLabel(k) })),
  },
];
---

<BaseLayout title={seo.title} description={seo.description} bodyClass="hm ap fv fa ca">
  <Nav logoHref="/" scrolled />
  <NavMenu pathPrefix="/" />

  <main>
    <section class="fa-hero ap-edge" id="top">
      <h1 class="fa-hero-title">those finding their <i>spark.</i></h1>
      <p class="fa-hero-sub">
        Meet the <em>challengers</em> discovering what drives them.
      </p>
    </section>

    <section class="ca-body ap-edge">
      <div class="ca-table" id="caTable">
        <div class="fv-filters" id="caFilters">
          {filters.map((f) => (
            <div class="fv-filter" data-key={f.key}>
              <button class="fv-fbtn" type="button" aria-expanded="false">
                <span class="fv-fbtn-label">{f.label}</span>
                <span class="fv-caret" aria-hidden="true"></span>
              </button>
              <div class="fv-menu" role="listbox" aria-label={f.label}>
                <button class="fv-opt is-on" type="button" role="option" aria-selected="true" data-val="">
                  {f.all}
                </button>
                {f.options.map((o) => (
                  <button class="fv-opt" type="button" role="option" aria-selected="false" data-val={o.value}>
                    <span class="fv-opt-label">{o.label}</span>
                  </button>
                ))}
              </div>
            </div>
          ))}

          <button class="fa-reset" id="caReset" type="button">clear filters</button>

          <div class="fv-filter ca-search fv-searchbox" data-key="q">
            <button class="fv-fbtn" type="button" aria-expanded="false">
              <span class="fv-fbtn-label">search</span>
              <span class="fv-caret" aria-hidden="true"></span>
            </button>
            <div class="fv-menu ca-searchmenu">
              <input
                class="ca-input"
                id="caSearch"
                type="text"
                placeholder="type a name"
                aria-label="Search by name"
              />
            </div>
          </div>
        </div>

        <div class="ca-rows" id="caRows">
          {challengers.map((p) => {
            const key = yearKey(p.year);
            return (
              <div
                class="ca-row"
                data-name={nameOf(p)}
                data-university={p.university ?? ''}
                data-department={p.department ?? ''}
                data-year={key}
              >
                <div class="ca-cell ca-name">{nameOf(p)}</div>
                <div class="ca-cell">{p.university}</div>
                <div class="ca-cell">{p.department}</div>
                <div class="ca-cell">{yearLabel(key)}</div>
              </div>
            );
          })}
        </div>

        <p class="ca-empty" id="caEmpty" hidden>
          Nothing matches just yet. Try tweaking your filters and see what turns up.
        </p>

        <div class="lm" id="caMore" data-noun="challengers">
          <p class="lm-status" id="caStatus" aria-live="polite" tabindex="-1"></p>
          <button class="h3btn lm-btn" id="caMoreBtn" type="button" hidden>
            <span class="h3btn-label">load more</span>
            <span class="cta-arrow" aria-hidden="true"></span>
          </button>
        </div>
      </div>
    </section>
  </main>

  <Footer footer={home.footer} apiBase={apiBase} />
</BaseLayout>

<script>
  import '../scripts/home.js';
  import '../scripts/challengers.js';
</script>
