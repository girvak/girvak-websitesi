# GİRVAK backend configuration — names only. Values live in the environment
# (or in a local .env, which is git-ignored). Unknown names fail the boot.

# local | ci | staging | production
ENVIRONMENT=local
LOG_LEVEL=INFO

# OpenAPI at /docs. Keep false in production.
DOCS_ENABLED=true

# Browser origins allowed to call this API (comma separated).
CORS_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
# Host header values this process answers to (comma separated).
TRUSTED_HOSTS=localhost,127.0.0.1

# Required. Header X-Admin-Token on POST /v1/content/refresh.
ADMIN_API_KEY=

# --- PostgreSQL ---
DATABASE__DSN=postgresql+asyncpg://girvak:girvak@127.0.0.1:5432/girvak
DATABASE__POOL_SIZE=5
DATABASE__MAX_OVERFLOW=5
DATABASE__STATEMENT_TIMEOUT_MS=5000

# --- Content ---
# seed  = committed JSON only (no Airtable call)
# airtable = Airtable, falling back to the seed per missing section
CONTENT__SOURCE=seed
CONTENT__TTL_SECONDS=600
CONTENT__HTTP_MAX_AGE_SECONDS=60
CONTENT__HTTP_STALE_WHILE_REVALIDATE_SECONDS=300

# --- Airtable (required when CONTENT__SOURCE=airtable) ---
AIRTABLE__API_KEY=
AIRTABLE__BASE_ID=
AIRTABLE__TABLE_HOME=home
AIRTABLE__TABLE_ABOUT=about
AIRTABLE__TABLE_FELLOW=fellow
AIRTABLE__TABLE_PARTNER=partner
AIRTABLE__TABLE_PEOPLE=people
AIRTABLE__TABLE_ICONS=icons

# --- Attachment mirror (Airtable's own URLs expire within hours) ---
MEDIA__MIRROR=true
MEDIA__DIR_PATH=media
MEDIA__URL_PREFIX=/media

# --- Caps ---
LIMITS__NEWSLETTER_PER_IP_PER_HOUR=10
LIMITS__REFRESH_PER_MINUTE=6
