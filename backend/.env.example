# --- GİRVAK backend configuration ---

# Comma-separated list of allowed CORS origins (the frontend dev + prod URLs)
CORS_ORIGINS=http://localhost:4321,http://127.0.0.1:4321

# Content source: "seed" (local JSON) or "airtable"
CONTENT_SOURCE=seed

# Path to the SQLite database file (newsletter subscribers)
DB_PATH=girvak.db

# --- Airtable (only used when CONTENT_SOURCE=airtable) ---
# Personal Access Token (create at https://airtable.com/create/tokens with
# data.records:read scope on your base) and the base id (starts with "app").
# AIRTABLE_API_KEY=patXXXXXXXXXXXXXX.XXXXXXXX...
# AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# Table names — override to match your base. Any missing/empty table just keeps
# the bundled seed value for that section.
# AIRTABLE_TABLE_SETTINGS=Settings
# AIRTABLE_TABLE_HERO_IMAGES=HeroImages
# AIRTABLE_TABLE_IMPACT=Impact
# AIRTABLE_TABLE_WHATWEDO=WhatWeDo
# AIRTABLE_TABLE_FELLOWS=Fellows
# AIRTABLE_TABLE_PARTNERS=Partners
