# --- GİRVAK backend configuration ---

# Comma-separated list of allowed CORS origins (the frontend dev + prod URLs)
# Dev:  http://localhost:4321
# Prod: https://girisimcilikvakfi.org,https://www.girisimcilikvakfi.org
CORS_ORIGINS=http://localhost:4321,http://127.0.0.1:4321

# Host header values allowed by TrustedHostMiddleware (prod domain + localhost)
ALLOWED_HOSTS=localhost,127.0.0.1,girisimcilikvakfi.org,www.girisimcilikvakfi.org

# Expose internal debug routes (e.g. /api/content/publish-guide)
ENABLE_DEBUG_ROUTES=false

# Shared secret for admin endpoints (POST /api/content/refresh).
# Required header: X-Admin-Token: <value>
# ADMIN_API_KEY=change-me-to-a-long-random-string

# Content source: "seed" (local JSON) or "airtable"
CONTENT_SOURCE=seed

# Path to the SQLite database file (newsletter subscribers)
DB_PATH=girvak.db

# --- Airtable (only used when CONTENT_SOURCE=airtable) ---
# Personal Access Token (create at https://airtable.com/create/tokens with
# data.records:read scope on your base) and the base id (starts with "app").
# AIRTABLE_API_KEY=patXXXXXXXXXXXXXX.XXXXXXXX...
# AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# When true, PATCH Airtable `dynamic` checkboxes on content refresh (requires write token).
AIRTABLE_SYNC_DYNAMIC=false

# Table names — override to match your base. Any missing/empty table just keeps
# the bundled seed value for that section.
# AIRTABLE_TABLE_SETTINGS=Settings
# AIRTABLE_TABLE_HERO_IMAGES=HeroImages
# AIRTABLE_TABLE_IMPACT=Impact
# AIRTABLE_TABLE_WHATWEDO=WhatWeDo
# AIRTABLE_TABLE_FELLOWS=Fellows
# AIRTABLE_TABLE_PARTNERS=Partners

# --- Airtable attachment mirror ---
# Airtable attachment URLs expire after a few hours, so a static build's images
# would start returning 403. The backend copies each attachment to disk once and
# serves it from /media (non-expiring). Set false only for debugging.
MEDIA_MIRROR=true
# MEDIA_DIR_PATH=media        # relative paths resolve next to backend/
# MEDIA_URL_PREFIX=/media
