# GİRVAK — single env file for the whole repo (git-ignored as `.env`).
# Copy: cp .env.example .env
# Used by: docker compose, backend (Settings), frontend (Astro / Vite).
# Frontend/compose-only names are ignored by the API; required backend fields
# still fail validation if missing or mistyped.

# =============================================================================
# Compose / PostgreSQL
# =============================================================================
# Required by docker-compose.yml for the db service and the backend DSN override.
POSTGRES_PASSWORD=

# =============================================================================
# Backend (FastAPI)
# =============================================================================
# local | ci | staging | production
ENVIRONMENT=local
LOG_LEVEL=INFO

# OpenAPI at /docs. Keep false in production (compose also forces false).
DOCS_ENABLED=true

# Browser origins allowed to call this API (comma separated).
CORS_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
# Host header values this process answers to (comma separated).
TRUSTED_HOSTS=localhost,127.0.0.1

# Required. Header X-Admin-Token on POST /v1/content/refresh.
ADMIN_API_KEY=

# --- PostgreSQL (local; compose overrides DSN to the `db` service) ---
DATABASE__DSN=postgresql+asyncpg://girvak:girvak@127.0.0.1:5432/girvak
DATABASE__POOL_SIZE=5
DATABASE__MAX_OVERFLOW=5
DATABASE__STATEMENT_TIMEOUT_MS=5000

# --- Content ---
# seed  = committed JSON only (no Airtable call)
# airtable = Airtable, falling back to the seed per missing section
CONTENT__SOURCE=seed
CONTENT__TTL_SECONDS=600
CONTENT__HTTP_MAX_AGE_SECONDS=60
CONTENT__HTTP_STALE_WHILE_REVALIDATE_SECONDS=300

# --- Airtable (required when CONTENT__SOURCE=airtable) ---
AIRTABLE__API_KEY=
AIRTABLE__BASE_ID=
AIRTABLE__TABLE_HOME=home
AIRTABLE__TABLE_ABOUT=about
AIRTABLE__TABLE_FELLOW=fellow
AIRTABLE__TABLE_PARTNER=partner
AIRTABLE__TABLE_PEOPLE=people
AIRTABLE__TABLE_ICONS=icons
AIRTABLE__TABLE_VENTURES=ventures
AIRTABLE__TABLE_SECTORS=sectors
AIRTABLE__TABLE_PROGRAMS=programs_detailed
AIRTABLE__TABLE_PROGRAM_CATEGORIES=programs
AIRTABLE__TABLE_APPLICATIONS=applications

# --- Attachment mirror (Airtable's own URLs expire within hours) ---
# The last good copy of every page is also written here, so a restart during an
# Airtable outage serves the latest content, not the repo's seed. Local: relative
# to backend/. Compose sets CONTENT__BACKUP_DIR_PATH=/app/content-backup.
CONTENT__BACKUP=true
CONTENT__BACKUP_DIR_PATH=content-backup
MEDIA__MIRROR=true
# Local: relative to backend/. Compose sets MEDIA__DIR_PATH=/app/media.
MEDIA__DIR_PATH=media
MEDIA__URL_PREFIX=/media

# --- Caps ---
LIMITS__NEWSLETTER_PER_IP_PER_HOUR=10
LIMITS__REFRESH_PER_MINUTE=6

# =============================================================================
# Frontend (Astro SSR)
# =============================================================================
# Where server-rendered pages read content from. Server-side only.
# Local default; compose overrides to http://backend:8000.
API_BASE_URL=http://127.0.0.1:8000

# Browser newsletter posts. Empty = same origin (nginx /api in production).
PUBLIC_API_BASE_URL=

# Canonical origin for canonical links, Open Graph and the sitemap.
PUBLIC_SITE_URL=https://girisimcilikvakfi.org

PAGE_CACHE_SECONDS=30
BROWSER_CACHE_SECONDS=30

# Optional. /apply "interest form" link. Empty → scrolls to the footer newsletter.
PUBLIC_INTEREST_FORM_URL=
